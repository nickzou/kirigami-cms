{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "default": {},
  "type": "object",
  "properties": {
    "theme": {
      "title": "Theme",
      "description": "How the site looks.",
      "default": {},
      "type": "object",
      "properties": {
        "colors": {
          "title": "Colors",
          "description": "The palette of the site.",
          "group": "general",
          "default": {},
          "type": "object",
          "properties": {
            "background": {
              "default": "#ffffff",
              "title": "Background",
              "description": "The page background.",
              "widget": "color",
              "type": "string",
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(rgb|rgba|hsl|hsla|hwb|lab|lch|oklab|oklch|color)\\([0-9a-zA-Z\\s,./%+-]*\\))$"
            },
            "text": {
              "default": "#1a1a1a",
              "title": "Text",
              "description": "Body text.",
              "widget": "color",
              "type": "string",
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(rgb|rgba|hsl|hsla|hwb|lab|lch|oklab|oklch|color)\\([0-9a-zA-Z\\s,./%+-]*\\))$"
            },
            "muted": {
              "default": "#5c5c5c",
              "title": "Muted text",
              "description": "Secondary text, such as captions and dates.",
              "widget": "color",
              "type": "string",
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(rgb|rgba|hsl|hsla|hwb|lab|lch|oklab|oklch|color)\\([0-9a-zA-Z\\s,./%+-]*\\))$"
            },
            "link": {
              "default": "#0b57d0",
              "title": "Links",
              "description": "The color of links.",
              "widget": "color",
              "type": "string",
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(rgb|rgba|hsl|hsla|hwb|lab|lch|oklab|oklch|color)\\([0-9a-zA-Z\\s,./%+-]*\\))$"
            },
            "border": {
              "default": "#d9d9d9",
              "title": "Borders",
              "description": "Lines and rules, such as table borders and dividers.",
              "widget": "color",
              "type": "string",
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(rgb|rgba|hsl|hsla|hwb|lab|lch|oklab|oklch|color)\\([0-9a-zA-Z\\s,./%+-]*\\))$"
            },
            "codeBackground": {
              "default": "#f4f4f5",
              "title": "Code background",
              "description": "Behind code blocks and inline code.",
              "widget": "color",
              "type": "string",
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(rgb|rgba|hsl|hsla|hwb|lab|lch|oklab|oklch|color)\\([0-9a-zA-Z\\s,./%+-]*\\))$"
            }
          },
          "additionalProperties": false
        },
        "fonts": {
          "title": "Fonts",
          "description": "Font-family lists. Fonts already on the reader's device are used.",
          "group": "general",
          "default": {},
          "type": "object",
          "properties": {
            "body": {
              "default": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
              "title": "Body font",
              "description": "A font-family list, ending with a generic family, such as: Georgia, \"Times New Roman\", serif",
              "widget": "font",
              "type": "string",
              "minLength": 1
            },
            "heading": {
              "default": "inherit",
              "title": "Heading font",
              "description": "A font-family list for headings, or inherit to use the body font.",
              "widget": "font",
              "type": "string",
              "minLength": 1
            },
            "mono": {
              "default": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
              "title": "Code font",
              "description": "A font-family list for code.",
              "widget": "font",
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "type": {
          "title": "Type",
          "description": "The size and rhythm of text.",
          "group": "advanced",
          "default": {},
          "type": "object",
          "properties": {
            "baseSize": {
              "default": "1.125rem",
              "title": "Base size",
              "description": "The size of body text, such as 1.125rem or 18px.",
              "widget": "length",
              "type": "string",
              "pattern": "^(\\d+|\\d*\\.\\d+)(px|rem|em|ch|vw|%)$"
            },
            "scale": {
              "default": 1.25,
              "title": "Heading scale",
              "description": "The ratio between heading levels, from 1 to 2. 1.25 is a \"major third\".",
              "widget": "number",
              "type": "number",
              "minimum": 1,
              "maximum": 2
            },
            "lineHeight": {
              "default": 1.6,
              "title": "Line height",
              "description": "The space between lines, as a multiple of the text size.",
              "widget": "number",
              "type": "number",
              "minimum": 1,
              "maximum": 3
            }
          },
          "additionalProperties": false
        },
        "spacing": {
          "title": "Spacing",
          "description": "How much room there is around things.",
          "group": "advanced",
          "default": {},
          "type": "object",
          "properties": {
            "unit": {
              "default": "1rem",
              "title": "Spacing unit",
              "description": "The basic gap. Margins and padding are multiples of it.",
              "widget": "length",
              "type": "string",
              "pattern": "^(\\d+|\\d*\\.\\d+)(px|rem|em|ch|vw|%)$"
            }
          },
          "additionalProperties": false
        },
        "layout": {
          "title": "Layout",
          "description": "The shape of the page.",
          "group": "general",
          "default": {},
          "type": "object",
          "properties": {
            "maxWidth": {
              "default": "44rem",
              "title": "Content width",
              "description": "The widest the text column gets, such as 44rem or 70ch.",
              "widget": "length",
              "type": "string",
              "pattern": "^(\\d+|\\d*\\.\\d+)(px|rem|em|ch|vw|%)$"
            }
          },
          "additionalProperties": false
        },
        "headings": {
          "title": "Headings",
          "description": "The size and weight of each heading level.",
          "default": {},
          "type": "object",
          "properties": {
            "h1": {
              "title": "Heading 1",
              "description": "The size and weight of <h1> headings.",
              "group": "advanced",
              "default": {},
              "type": "object",
              "properties": {
                "size": {
                  "default": "auto",
                  "title": "Heading 1 size",
                  "description": "The size of <h1> headings, such as 2rem, or auto for the size the heading scale gives.",
                  "widget": "length",
                  "type": "string",
                  "pattern": "^(auto|(\\d+|\\d*\\.\\d+)(px|rem|em|ch|vw|%))$"
                },
                "weight": {
                  "default": 700,
                  "title": "Heading 1 weight",
                  "description": "How bold <h1> headings are: 400 is normal, 700 is bold.",
                  "widget": "number",
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900,
                  "multipleOf": 100
                }
              },
              "additionalProperties": false
            },
            "h2": {
              "title": "Heading 2",
              "description": "The size and weight of <h2> headings.",
              "group": "advanced",
              "default": {},
              "type": "object",
              "properties": {
                "size": {
                  "default": "auto",
                  "title": "Heading 2 size",
                  "description": "The size of <h2> headings, such as 2rem, or auto for the size the heading scale gives.",
                  "widget": "length",
                  "type": "string",
                  "pattern": "^(auto|(\\d+|\\d*\\.\\d+)(px|rem|em|ch|vw|%))$"
                },
                "weight": {
                  "default": 700,
                  "title": "Heading 2 weight",
                  "description": "How bold <h2> headings are: 400 is normal, 700 is bold.",
                  "widget": "number",
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900,
                  "multipleOf": 100
                }
              },
              "additionalProperties": false
            },
            "h3": {
              "title": "Heading 3",
              "description": "The size and weight of <h3> headings.",
              "group": "advanced",
              "default": {},
              "type": "object",
              "properties": {
                "size": {
                  "default": "auto",
                  "title": "Heading 3 size",
                  "description": "The size of <h3> headings, such as 2rem, or auto for the size the heading scale gives.",
                  "widget": "length",
                  "type": "string",
                  "pattern": "^(auto|(\\d+|\\d*\\.\\d+)(px|rem|em|ch|vw|%))$"
                },
                "weight": {
                  "default": 700,
                  "title": "Heading 3 weight",
                  "description": "How bold <h3> headings are: 400 is normal, 700 is bold.",
                  "widget": "number",
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900,
                  "multipleOf": 100
                }
              },
              "additionalProperties": false
            },
            "h4": {
              "title": "Heading 4",
              "description": "The size and weight of <h4> headings.",
              "group": "advanced",
              "default": {},
              "type": "object",
              "properties": {
                "size": {
                  "default": "auto",
                  "title": "Heading 4 size",
                  "description": "The size of <h4> headings, such as 2rem, or auto for the size the heading scale gives.",
                  "widget": "length",
                  "type": "string",
                  "pattern": "^(auto|(\\d+|\\d*\\.\\d+)(px|rem|em|ch|vw|%))$"
                },
                "weight": {
                  "default": 700,
                  "title": "Heading 4 weight",
                  "description": "How bold <h4> headings are: 400 is normal, 700 is bold.",
                  "widget": "number",
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900,
                  "multipleOf": 100
                }
              },
              "additionalProperties": false
            },
            "h5": {
              "title": "Heading 5",
              "description": "The size and weight of <h5> headings.",
              "group": "advanced",
              "default": {},
              "type": "object",
              "properties": {
                "size": {
                  "default": "auto",
                  "title": "Heading 5 size",
                  "description": "The size of <h5> headings, such as 2rem, or auto for the size the heading scale gives.",
                  "widget": "length",
                  "type": "string",
                  "pattern": "^(auto|(\\d+|\\d*\\.\\d+)(px|rem|em|ch|vw|%))$"
                },
                "weight": {
                  "default": 700,
                  "title": "Heading 5 weight",
                  "description": "How bold <h5> headings are: 400 is normal, 700 is bold.",
                  "widget": "number",
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900,
                  "multipleOf": 100
                }
              },
              "additionalProperties": false
            },
            "h6": {
              "title": "Heading 6",
              "description": "The size and weight of <h6> headings.",
              "group": "advanced",
              "default": {},
              "type": "object",
              "properties": {
                "size": {
                  "default": "auto",
                  "title": "Heading 6 size",
                  "description": "The size of <h6> headings, such as 2rem, or auto for the size the heading scale gives.",
                  "widget": "length",
                  "type": "string",
                  "pattern": "^(auto|(\\d+|\\d*\\.\\d+)(px|rem|em|ch|vw|%))$"
                },
                "weight": {
                  "default": 700,
                  "title": "Heading 6 weight",
                  "description": "How bold <h6> headings are: 400 is normal, 700 is bold.",
                  "widget": "number",
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900,
                  "multipleOf": 100
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

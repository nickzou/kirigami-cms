{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "default": {},
  "type": "object",
  "properties": {
    "content": {
      "default": {
        "store": "local-folder",
        "path": "./content"
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "store": {
              "type": "string",
              "const": "local-folder"
            },
            "path": {
              "default": "./content",
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "store"
          ],
          "additionalProperties": false
        }
      ]
    },
    "build": {
      "default": {},
      "type": "object",
      "properties": {
        "out": {
          "default": "./dist",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

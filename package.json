{
  "name": "kirigami",
  "version": "0.0.0",
  "description": "A markdown-first, configuration-first CMS for developers and non-developers.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:boundaries",
    "schema": "pnpm build && node scripts/generate-json-schema.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/mdast": "4.0.4",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "18.7.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "mdast-util-to-string": "4.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}

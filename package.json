{
  "name": "kirigami",
  "version": "0.0.0",
  "description": "A markdown-first, configuration-first CMS for developers and non-developers.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:boundaries"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "18.7.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
